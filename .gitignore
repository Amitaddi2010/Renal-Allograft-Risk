# Operating System Files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/
*.swp

# Node / Scratch
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Documents / Manuscripts
docs/
*.docx

# Large HLAMatchmaker source workbooks (87 MB; the generated hla_reference_data.js is used by the app)
reference_sources/*.xlsb

# Raw structure files (regenerate with tools/fetch_structures.py); the trimmed bundle hla_structures_data.js is tracked
structures/

# IMGT/HLA alignment downloads and the parsed intermediate (regenerate with
# tools/fetch_imgt_alignments.py); the trimmed hla_molecular_data.js is tracked
tools/imgt_cache/
tools/imgt_alignments.json
